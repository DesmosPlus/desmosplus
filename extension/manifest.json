{
  "manifest_version": 3,
  "name": "DesmosPlus Transfer",
  "version": "1.1.2",
  "description": "Transfer calculator state between Desmos and DesmosPlus.",
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Transfer a Desmos graph",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
