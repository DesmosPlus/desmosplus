{
  "manifest_version": 3,
  "name": "Desmos+",
  "version": "1.18.0",
  "description": "Transfer graphs, make songs in Desmos, convert SVGs into Desmos graphs, and so much more!",
  "permissions": ["activeTab", "scripting", "storage"],
  "content_scripts": [
    {
      "matches": [
        "https://desmos.com/*",
        "https://*.desmos.com/*",
        "https://desmosplus.pages.dev/*"
      ],
      "css": ["dark-mode.css"],
      "js": ["dark-mode.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://desmos.com/calculator/*",
        "https://*.desmos.com/calculator/*"
      ],
      "js": ["autosave.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "DesmosPlus tools",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
