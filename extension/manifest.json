{
  "manifest_version": 3,
  "name": "Desmos+",
  "version": "1.16.2",
  "description": "Transfer graphs, make songs in Desmos, convert SVGs into Desmos graphs, and so much more!",
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "DesmosPlus tools",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
